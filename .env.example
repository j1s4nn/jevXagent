# ============================================================
# jevXagent configuration
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` — it contains secrets.
# ============================================================

# ---- Claude (primary model, upstream Anthropic-compatible API) ----
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api-cc.freemodel.dev
CLAUDE_TIMEOUT_S=300
# Optional: rewrite client-requested model ids to upstream-supported models.
# Format: "client_model=upstream_model,..." (comma-separated). Empty = transparent.
# Example (Claude Code sends claude-opus-5-5; map it to a supported model):
#CLAUDE_MODEL_MAP=claude-opus-5-5=claude-sonnet-5

# ---- JEV (decision coprocessor) ----
# NOTE: The JEV API was not available when this project started.
# When you receive a real JEV API key:
#   1. set JEV_API_KEY and JEV_BASE_URL here
#   2. verify the request/response protocol in JEV's docs
#      (provider code: src/jevxagent/providers/jev.py — marked "JEV API SUBMISSION POINT")
#   3. set JEV_ENABLED=true
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=

# ---- Proxy server ----
PROXY_HOST=127.0.0.1
PROXY_PORT=8787

# ---- Routing ----
JEV_ENABLED=false
ROUTING_ENABLED=false
# Comma-separated decision types allowed to route to JEV
JEV_ROUTABLE_TYPES=classification,binary_decision,multiple_choice,selection,simple_extraction,simple_comparison,entity_identification,verification,relevance,url_classification,simple_transformation,next_action,tool_selection

# ---- JEV behavior ----
JEV_TIMEOUT_S=3.0
JEV_MAX_RETRIES=1
JEV_CONFIDENCE_THRESHOLD=0.80
JEV_MAX_CONTEXT_CHARS=4000
# complexity above this value is never routed to JEV (fail-safe)
JEV_MAX_COMPLEXITY=0.60

# ---- Logging ----
LOG_LEVEL=INFO
DEBUG_REQUESTS=false

# ---- Telemetry / privacy ----
# Where statistics are stored (default: <repo>/data)
DATA_DIR=
STORE_PROMPTS=false
STORE_RESPONSES=false
STORE_DECISION_CONTEXT=false

# ---- Cost / estimation model ----
# Used ONLY to compute ESTIMATED savings (clearly labelled in reports).
# Prices are per 1M tokens. Leave empty to mark that metric unavailable.
CLAUDE_INPUT_PRICE_PER_MTOK=
CLAUDE_OUTPUT_PRICE_PER_MTOK=
JEV_INPUT_PRICE_PER_MTOK=
JEV_OUTPUT_PRICE_PER_MTOK=
# Fallback baseline estimates used when no historical Claude measurements exist
CLAUDE_EST_MS_PER_DECISION=
CLAUDE_EST_INPUT_TOKENS_PER_DECISION=
CLAUDE_EST_OUTPUT_TOKENS_PER_DECISION=
